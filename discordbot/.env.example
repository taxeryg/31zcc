# ── Discord Bot Config (Required) ─────────────────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
GUILD_ID=YOUR_GUILD_ID_HERE

# Allowed channel IDs (comma-separated, leave empty = all channels)
ALLOWED_CHANNELS=

# ── Account Creator Config (Optional) ─────────────────────────────────────────
# 2captcha.com API key — needed to solve Kick's hCaptcha during registration
# Get your key at: https://2captcha.com/enterpage
# Without this key the creator will try without captcha (lower success rate)
CAPTCHA_API_KEY=

# sms-activate.org API key — needed for phone/SMS verification on Kick
# Get your key at: https://sms-activate.org/en/api
# Leave empty to skip phone verification (some accounts may still be created)
SMS_ACTIVATE_KEY=
